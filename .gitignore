# Xcode
build/
DerivedData/
*.xcodeproj
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata
xcuserdata/
*.xcuserstate
.DS_Store

# Generated by XcodeGen — regenerate with `xcodegen generate`
Vantage.xcodeproj/

# Secrets — never commit. Keys live in the Keychain, entered via Settings.
Secrets.xcconfig
*.env

# Claude Code local state — machine-specific, records literal commands, and is
# where worktrees land. The whole directory, not just the settings file: a
# `git add -A` would otherwise sweep up whatever else appears in here.
.claude/
